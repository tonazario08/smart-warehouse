APP_ENV=development
APP_NAME=Smart Warehouse API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://smart_warehouse:change-me@db:5432/smart_warehouse
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
SEED_WAREHOUSE_EMAIL=warehouse@example.com
SEED_WAREHOUSE_PASSWORD=change-me-before-use
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=change-me-before-use
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
