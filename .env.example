# Copy to .env, replace every placeholder, then run docker compose up --build.
# Web UI: http://localhost:8080 | API: http://localhost:8000/api/v1
APP_ENV=production
APP_NAME=Smart Warehouse API
API_V1_PREFIX=/api/v1
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:8080"]
SEED_ADMIN_EMAIL=REPLACE_ME
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_WAREHOUSE_EMAIL=REPLACE_ME
SEED_WAREHOUSE_PASSWORD=REPLACE_ME
SEED_CLIENT_EMAIL=REPLACE_ME
SEED_CLIENT_PASSWORD=REPLACE_ME
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
